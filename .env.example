# Documentation only. No real credentials, and no automatic .env loading.
PUBLIC_BASE_URL=https://your-service.example
APP_SECRET=
MCP_LOGIN_PASSWORD=
ZOTERO_API_KEY=
ZOTERO_ALLOW_WRITE_KEY=false
ZOTERO_ENABLE_CONTENT_READS=false
ZOTERO_ENABLE_WRITES=false
# Required for write mode: an absolute path in an owned mode-0700 private directory.
# Example on a separately provisioned persistent volume: /var/data/zotero-private/changes.sqlite3
# Never point this at Zotero Desktop's database. No paid volume is created automatically.
ZOTERO_STATE_DB=
ZOTERO_ALLOW_PERMANENT_DELETE=false
ZOTERO_COLLECTION_NAME=Example Collection
ZOTERO_COLLECTION_KEY=
ZOTERO_LIBRARY_TYPE=user
ZOTERO_LIBRARY_ID=
OAUTH_REDIRECT_URIS=[]
LOCAL_DEV=false
PORT=8000
